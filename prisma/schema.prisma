// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Inspection {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())
  type            String   @default("Daily")
  date            String
  shift           String   @default("Unknown")
  lastName        String
  firstName       String
  equipmentLabel  String
  equipmentSerial String
  answers         Json
  review          Json?
}

// Overrides EQUIPMENT_LIST's hardcoded default location once someone
// reports the equipment is actually somewhere else — one row per serial,
// always the current known location for that piece of equipment.
model EquipmentLocation {
  serial    String   @id
  location  String
  updatedAt DateTime @updatedAt
  updatedBy String?
}
