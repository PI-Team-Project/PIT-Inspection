// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Inspection {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())
  type            String   @default("Daily")
  date            String
  shift           String   @default("Unknown")
  lastName        String
  firstName       String
  equipmentLabel  String
  equipmentSerial String
  answers         Json
  review          Json?
  photos          Photo[]

  // A query accelerator, NOT a source of truth. True while this inspection
  // still has a flagged item awaiting sign-off — i.e. while getStage would
  // call it "unresolved" or "pending-confirm".
  //
  // The dashboard needs a vehicle's whole history for one reason only:
  // findOpenIssue must keep surfacing an old unconfirmed flag no matter how
  // many clean inspections follow it. Without this it read the entire
  // retention window on every page load (22,340 rows / 1.8s at a year of
  // data, 99% of the server's work) to find a handful of rows. Now it asks
  // for those rows directly.
  //
  // Nothing renders from this column. Stage is still computed by getStage
  // via buildRow for display, so a stale value can only cost a row that
  // gets re-checked anyway — never a wrong status on screen. Defaults to
  // true so anything written without it is merely included, never missed.
  maybeOpen       Boolean  @default(true)

  // Nearly every query either scans recent inspections fleet-wide
  // (dashboard) or a single vehicle's history ordered by time (equipment
  // detail, retention filtering) — both were unindexed table scans before.
  @@index([createdAt])
  @@index([equipmentSerial, createdAt])
  // Fleet-wide "what is still open" — the dashboard's own question. Built
  // as a PARTIAL index (WHERE "maybeOpen") in the migration, so it stays
  // small no matter how many closed inspections pile up behind it; Prisma
  // has no syntax for that, hence the plain declaration here.
  @@index([maybeOpen, createdAt])
}

// Split out from Inspection.answers so the dashboard's fleet-wide query
// (which never renders individual photos, just a hasPhotos flag) doesn't
// have to pull every base64 photo into memory on every load — only the
// equipment detail page, which actually shows them, joins this in.
model Photo {
  id           String     @id @default(cuid())
  inspectionId String
  inspection   Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  questionId   String
  order        Int
  note         String?
  createdAt    DateTime   @default(now())

  // Object-storage key, e.g. "A4BC150348/<inspectionId>/horn-0.jpg". The
  // bytes live in a private Supabase Storage bucket and reach the browser
  // as short-lived signed URLs; nothing here is publicly addressable.
  //
  // Photos were base64 data URIs inside Postgres, which made them 94-98%
  // of everything stored — ~602MB a year at the 1280px budget, in the most
  // expensive place to keep an image. See src/lib/photoStorage.ts.
  storagePath  String?

  // The old inline form. Kept nullable rather than dropped so the 15
  // photos in backup-before-wipe-2026-08-28.json stay restorable, and so a
  // submission still succeeds if storage is unreachable — a worker must
  // never lose an inspection because a bucket is down. Exactly one of
  // these two is set; storagePath wins when both are.
  dataUri      String?

  @@index([inspectionId])
}

// The fleet's master vehicle list — supersedes the old hardcoded
// EQUIPMENT_LIST array plus the EquipmentLocation/EquipmentArchived
// override tables, now that supervisors can add/edit/retire vehicles
// through the Manage Vehicles page instead of a code deploy.
//
// A non-null retiredAt is a soft delete: hidden from the dashboard and
// the inspection wizard's equipment picker, past Inspection rows left
// untouched, and the row itself kept for 2 years for retention before
// being eligible for permanent removal.
model Equipment {
  serial       String    @id
  createdAt    DateTime  @default(now())
  type         String
  flNumber     String
  makeColor    String
  contractType String
  location     String
  notes        String?
  retiredAt    DateTime?
  retiredBy    String?

  // An inspector reporting "this isn't where it's supposed to be" is a
  // single unverified claim from whoever happened to be doing that day's
  // inspection — location drives real decisions elsewhere (where to send
  // someone to find a vehicle), so it only becomes the trusted `location`
  // once a supervisor approves it. A supervisor's own direct edit (through
  // LocationChangeControl or Manage Vehicles) is trusted immediately and
  // clears these instead, since they're a step above an inspector-observed
  // report. All three null together, or all three set together — never a
  // subset.
  pendingLocation           String?
  pendingLocationReportedBy String?
  pendingLocationReportedAt DateTime?
}
