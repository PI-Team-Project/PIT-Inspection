{
  "name": "pit-inspection",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:staging": "prisma dev --name pit-staging -p 5480 -P 5481 -d",
    "db:staging:stop": "prisma dev stop pit-staging",
    "db:staging:migrate": "node scripts/with-env.mjs .env.staging -- prisma migrate deploy",
    "db:staging:seed": "node scripts/with-env.mjs .env.staging -- tsx scripts/seed-loadtest.ts",
    "dev:staging": "node scripts/with-env.mjs .env.staging -- next dev",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "heic2any": "^0.0.4",
    "next": "16.2.12",
    "pg": "^8.22.0",
    "prisma": "^7.9.1",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "playwright": "^1.62.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
